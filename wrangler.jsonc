{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dlp-alert-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "workers_dev": true,

  "vars": {
    // ──────────────────────────────────────────────────────────────
    //  YOU MUST FILL IN THESE VALUES BEFORE DEPLOYING
    // ──────────────────────────────────────────────────────────────

    // Who should receive the email alert when a DLP match is found?
    // Comma-separate multiple addresses: "alice@company.com,bob@company.com"
    "EMAIL_ALERT_TO": "<YOUR_RECIPIENT_EMAIL>",

    // What address should the alert email come FROM?
    // Must be a domain you control (you'll add a DNS record for it in Step 3).
    "EMAIL_ALERT_FROM": "dlp-alerts@<YOUR_DOMAIN>",

    // Display name shown in the "From" field of the email
    "EMAIL_ALERT_FROM_NAME": "Cloudflare DLP Alert",

    // Slack webhook URL — leave empty string if you only want email alerts.
    // If you want Slack alerts too, set this via:  npx wrangler secret put SLACK_WEBHOOK_URL
    "SLACK_WEBHOOK_URL": ""
  }
}
